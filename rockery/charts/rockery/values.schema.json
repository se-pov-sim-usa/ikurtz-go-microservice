{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["environment", "image"],
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["dev", "preprod", "prod"],
      "description": "Environment tier."
    },
    "cluster": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "group": { "type": "string" }
      }
    },
    "image": {
      "type": "object",
      "anyOf": [
        { "required": ["reference"], "properties": { "reference": { "minLength": 1 } } },
        {
          "required": ["repository", "tag"],
          "properties": { "repository": { "minLength": 1 }, "tag": { "minLength": 1 } }
        }
      ],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^$|^[^\\s]+(:[A-Za-z0-9][A-Za-z0-9._-]{0,127}|@sha256:[a-f0-9]{64})$",
          "not": { "pattern": ":latest$" },
          "description": "Full image reference with an explicit tag or digest, e.g. <registry>/rockery:3f9c2ab. ':latest' is rejected."
        },
        "repository": {
          "type": "string",
          "description": "Image repository, e.g. 123456789012.dkr.ecr.us-west-2.amazonaws.com/rockery. Empty is allowed here (the default); the anyOf above requires it, with a tag, when no reference is given."
        },
        "tag": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "not": { "enum": ["latest"] },
          "description": "Immutable tag. 'latest' is rejected on purpose."
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
